{
  "name": "neocom-domain",
  "version": "0.29.3",
  "description": "neocomusiness-domain TypeScript classes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean & tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "distribute": "npm run test && npm run build && node scripts/version-after-distribute.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "version:sync": "node scripts/version-from-npm.mjs",
    "version:bump:patch": "npm version patch --no-git-tag-version",
    "version:bump:minor": "npm version minor --no-git-tag-version",
    "version:bump:major": "npm version major --no-git-tag-version",
    "version:tag": "node scripts/version-tag-from-package.mjs",
    "publish:lib": "npm run version:sync && npm run version:bump:minor && npm run test && npm run build && npm publish && npm run version:sync && npm run version:tag"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "builder-pattern": "^2.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  }
}
