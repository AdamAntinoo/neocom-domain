{
  "name": "neocom-domain",
  "version": "0.30.0",
  "description": "neocomusiness-domain TypeScript classes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean & tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "distribute": "npm run test && npm run build3 ",
    "version:sync": "npm pkg set version=$(gitversion /nocache /showvariable SemVer)"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "builder-pattern": "^2.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  }
}
